# Bifrost gateway (self-hosted, see scripts/run_bifrost.sh)
BIFROST_URL=http://localhost:8080
# The virtual key clients send in x-bf-vk. Any string you choose; Bifrost reads it from this env var too.
BIFROST_VK=sk-bf-change-me
# Lets the CLI read Bifrost's logs and budget counters for the run summary (optional).
BIFROST_SETUP_TOKEN=change-me-setup-token
# Upstream key Bifrost uses for the "otari" provider (any OpenAI-compatible endpoint works, see README).
OTARI_API_KEY=your-otari-key

# Tavily (free Researcher plan: 1,000 credits/month)
TAVILY_API_KEY=tvly-...

# Models (Bifrost "provider/model" names)
STALE_MODEL=otari/alibaba/qwen3-30b-a3b-instruct-2507
STALE_ASSESS_MODEL=otari/alibaba/qwen3-235b-a22b-instruct-2507
STALE_FALLBACKS=otari/mistralai/mistral-small-3
